Cell[BoxData[{
 RowBox[{
  RowBox[{"amin", "[", "l_", "]"}], ":=", 
  RowBox[{
   RowBox[{"a", "/.", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Lr", "[", 
          RowBox[{"r", ",", "a", ",", "l"}], "]"}], "\[Equal]", "0"}], "&&", 
        " ", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{"Ene", "[", 
           RowBox[{"r", ",", "a", ",", "l"}], "]"}]}], "\[Equal]", 
         "\[Eta]1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "0.999"}], "}"}]}], "}"}]}], "]"}]}], "//", 
   "Quiet"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aa", "[", "l_", "]"}], ":=", 
  RowBox[{
   RowBox[{"a", "/.", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Lr", "[", 
          RowBox[{"r", ",", "a", ",", "l"}], "]"}], "\[Equal]", "0"}], "&&", 
        " ", 
        RowBox[{
         RowBox[{"1", "-", 
          RowBox[{"Ene", "[", 
           RowBox[{"r", ",", "a", ",", "l"}], "]"}]}], "\[Equal]", 
         "\[Eta]2"}]}], "}"}], ",", 
      RowBox[{"{", 
