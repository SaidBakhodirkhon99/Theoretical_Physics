          RowBox[{"r", ",", "q"}], "]"}]}]}], ")"}], "2"]}]]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"rarb_", ",", "q_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{"-", "Mdot"}], " ", 
