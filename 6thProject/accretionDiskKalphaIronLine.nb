Cell[CellGroupData[{

Cell["ISCO radii", "Section",
 CellChangeTimes->{{3.980476272129999*^9, 
  3.9804762740862427`*^9}},ExpressionUUID->"cafed55f-38b5-49bf-8514-\
aa451986fffd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"risc", "[", "q_", "]"}], ":=", 
   RowBox[{"r", "/.", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Ll", "[", 
          RowBox[{"r", ",", "q"}], "]"}], ",", "r"}], "]"}], "==", "0"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "5"}], "}"}]}], "]"}]}]}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "massive", " ", "particles", " ", "ISCO", " ", "of", " ", "\[Zeta]", " ", 
    "distribution"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z1", " ", "=", 
   RowBox[{"1", "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["a", "2"]}], ")"}], 
      RowBox[{"1", "/", "3"}]], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "a"}], ")"}], 
        RowBox[{"1", "/", "3"}]], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "a"}], ")"}], 
        RowBox[{"1", "/", "3"}]]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"z2", " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"3", " ", 
      SuperscriptBox["a", "2"]}], " ", "+", " ", 
     SuperscriptBox["z1", "2"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rk", "[", "a_", "]"}], "=", 
    RowBox[{"3", "+", "z2", "-", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"a", "<", "0"}], ",", 
        RowBox[{"-", "1"}], ",", "1"}], "]"}], 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", "-", "z1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"3", "+", "z1", "+", 
          RowBox[{"2", " ", "z2"}]}], ")"}]}], "]"}]}]}]}], "   ", ";"}], 
  "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"Kerr", " ", "metric", " ", "isco", " ", "radii"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rk", "[", "x", "]"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"x", "<", "0"}], ",", "None", ",", 
       RowBox[{"risc", "[", "x", "]"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<q/M,  a/M\>\"", ",", 
      "\"\<\!\(\*SubscriptBox[\(r\), \(ISCO\)]\)/M\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "6.3"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Black", ",", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Dashed"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Dashed"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"LabelStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FontFamily", " ", "\[Rule]", " ", "\"\<Times\>\""}], ",", 
      "Black", ",", "Bold", ",", " ", "Italic", ",", 
      RowBox[{"FontSize", "\[Rule]", " ", "12"}]}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", "\"\<Kerr\>\"", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Scaled", "[", 
         RowBox[{"{", 
          RowBox[{"0.72", ",", "0.48"}], "}"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.4", ",", " ", "0.5"}], "}"}]}], "}"}]}], "]"}]}], ",", 
   RowBox[{"AspectRatio", "->", "1"}]}], "]"}], "\n"}], "Input",
