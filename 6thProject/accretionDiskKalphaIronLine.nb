Cell[CellGroupData[{

Cell["Specific energy and angular momentum", "Section",
 CellChangeTimes->{{3.980453393716981*^9, 
  3.980453406256551*^9}},ExpressionUUID->"cec8143a-abb0-4bbb-af0b-\
d060641e73ae"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\[CapitalOmega]", "]"}]], "Input",
 CellChangeTimes->{{3.981261961043912*^9, 3.981261965707068*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"c5fe38af-9601-4512-bdf3-8e1543e7ead1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalOmega]", "[", 
    RowBox[{"r_", ",", "q_"}], "]"}], " ", "=", " ", 
   SqrtBox[
    FractionBox[
     RowBox[{"-", " ", 
      RowBox[{"D", "[", 
       RowBox[{"gtt", ",", "r"}], "]"}]}], 
     RowBox[{"D", "[", 
      RowBox[{"g\[Phi]\[Phi]", ",", "r"}], "]"}]]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Ll", "[", 
     RowBox[{"r_", ",", "q_"}], "]"}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"\[CapitalOmega]", "[", 
        RowBox[{"r", ",", "q"}], "]"}], " ", "g\[Phi]\[Phi]"}], 
      SqrtBox[
       RowBox[{
        RowBox[{"-", "gtt"}], " ", "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"\[CapitalOmega]", "[", 
           RowBox[{"r", ",", "q"}], "]"}], "2"], " ", "g\[Phi]\[Phi]"}]}]]], 
     " ", 
     RowBox[{"(*", 
      SqrtBox[
       RowBox[{" ", 
        FractionBox[
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"r", ",", "q"}], "]"}], ",", "r"}], "]"}], " ", 
          SuperscriptBox["r", "3"]}], 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"f", "[", 
            RowBox[{"r", ",", "q"}], "]"}], " ", "r"}], " ", "-", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"r", ",", "q"}], "]"}], ",", "r"}], "]"}]}]]}]], "*)"}], 
     "//", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ene", "[", 
    RowBox[{"r_", ",", "q_"}], "]"}], " ", "=", " ", 
   FractionBox[
    RowBox[{"-", "gtt"}], 
    SqrtBox[
     RowBox[{
      RowBox[{"-", "gtt"}], " ", "-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"\[CapitalOmega]", "[", 
         RowBox[{"r", ",", "q"}], "]"}], "2"], " ", "g\[Phi]\[Phi]"}]}]]]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.980462019416122*^9, 3.980462141696019*^9}, 
   3.980539549129937*^9, {3.980573187007227*^9, 3.980573199301523*^9}, {
   3.981261948922769*^9, 3.981261954482638*^9}, 3.981262163092913*^9, {
   3.981340059809233*^9, 3.981340060661278*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"c5e31ce6-3873-4306-a5bf-508a84e84a5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", "[", 
      RowBox[{"r", ",", "0."}], "]"}], ",", 
     RowBox[{"\[CapitalOmega]", "[", 
