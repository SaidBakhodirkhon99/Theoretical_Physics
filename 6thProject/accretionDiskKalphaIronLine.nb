Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"r_", ",", "q_"}], "]"}], "=", 
   RowBox[{"1", "-", 
    RowBox[{
     FractionBox["2", "r"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Tanh", "[", 
        FractionBox[
         SuperscriptBox["q", "2"], 
         RowBox[{"2", "r"}]], "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]", "=", 
   RowBox[{"\[Pi]", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gtt", "=", 
   RowBox[{"-", 
    RowBox[{"f", "[", 
     RowBox[{"r", ",", "q"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"grr", " ", "=", " ", 
   FractionBox[
    RowBox[{"-", "1"}], "gtt"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g\[Theta]\[Theta]", " ", "=", " ", 
   SuperscriptBox["r", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g\[Phi]\[Phi]", " ", "=", " ", 
   RowBox[{
    SuperscriptBox["r", "2"], " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ";"}]}], "Input",
