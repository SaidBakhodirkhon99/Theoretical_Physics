Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kr", "[", 
    RowBox[{"r_", ",", "q_"}], "]"}], "=", 
   FractionBox[
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"\[CapitalOmega]", "[", 
       RowBox[{"r", ",", "q"}], "]"}], ",", "r"}], "]"}], 
    RowBox[{
     SqrtBox[
      RowBox[{"-", 
       RowBox[{"Det", "[", "g", "]"}]}]], " ", 
