Cell[BoxData[{
 RowBox[{
  RowBox[{"amin", "[", "l_", "]"}], ":=", 
  RowBox[{
   RowBox[{"a", "/.", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Lr", "[", 
          RowBox[{"r", ",", "a", ",", "l"}], "]"}], "\[Equal]", "0"}], "&&", 
        " ", 
        RowBox[{
