Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Veff", "[", 
    RowBox[{"r_", ",", "a_", ",", "\[Alpha]_", ",", "Ene_", ",", "L_"}], 
    "]"}], "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["Ene", "2"], " ", 
        RowBox[{"g44", "[", 
         RowBox[{"r", ",", "a", ",", "\[Alpha]"}], "]"}]}], " ", "+", " ", 
       RowBox[{"2", " ", "Ene", " ", "L", " ", 
        RowBox[{"g14", "[", 
         RowBox[{"r", ",", "a", ",", "\[Alpha]"}], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["L", "2"], " ", 
        RowBox[{"g11", "[", 
         RowBox[{"r", ",", "a", ",", "\[Alpha]"}], "]"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"g14", "[", 
         RowBox[{"r", ",", "a", ",", "\[Alpha]"}], "]"}], "2"], " ", "-", " ", 
       RowBox[{
        RowBox[{"g11", "[", 
         RowBox[{"r", ",", "a", ",", "\[Alpha]"}], "]"}], " ", 
        RowBox[{"g44", "[", 
         RowBox[{"r", ",", "a", ",", "\[Alpha]"}], "]"}]}]}], ")"}]}], "-", 
    "1"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.949474440554442*^9, 3.949474529285468*^9}, {
  3.9506556523076677`*^9, 3.950655653971672*^9}, {3.9511891285584793`*^9, 
