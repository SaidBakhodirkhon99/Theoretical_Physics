Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"double t2 = 1/r;\"\>"},
    {"\<\"double t3 = 1/mpar;\"\>"},
    {"\<\"double t5 = pow(qpar,2);\"\>"},
    {"\<\"double t6 = (t2*t3*t5)/2.;\"\>"},
    {"\<\"double t7 = Tanh(t6);\"\>"},
    {"\<\"double t8 = -t7;\"\>"},
    {"\<\"double t9 = 1 + t8;\"\>"},
    {"\<\"double t15 = pow(r,2);\"\>"},
    {"\<\"double t16 = sin(th);\"\>"},
    {"\<\"double t17 = pow(t16,2);\"\>"},
    {"\<\"double t20 = Sech(t6);\"\>"},
    {"\<\"double t21 = pow(t20,2);\"\>"},
    {"\<\"double t19 = pow(r,-3);\"\>"},
    {"\<\"gtt = -1 + 2*mpar*t2*t9;\"\>"},
    {"\<\"grr = 1/(1 - 2*mpar*t2*t9);\"\>"},
    {"\<\"gthth = t15;\"\>"},
    {"\<\"gpp = t15*t17;\"\>"},
    {"\<\"gtp = 0;\"\>"},
    {"\<\"dgttdr = t19*t21*t5 - (2*mpar*t9)/pow(r,2);\"\>"},
    {"\<\"dgppdr = 2*r*t17;\"\>"},
    {"\<\"dgtpdr = 0;\"\>"},
    {"\<\"dgttdr2 = (-4*t21*t5)/pow(r,4) + (pow(qpar,4)*t21*t3*t7)/pow(r,5) + \
4*mpar*t19*t9;\"\>"},
    {"\<\"dgppdr2 = 2*t17;\"\>"},
    {"\<\"dgtpdr2 = 0;\"\>"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{{3.989105383307613*^9, 3.9891054157711353`*^9}, 
   3.989105457509922*^9, 3.989105516182321*^9},
 CellLabel->
  "Out[106]=",ExpressionUUID->"43a8f94e-57ac-4971-8817-e97b7a832d05"]
}, Open  ]],

