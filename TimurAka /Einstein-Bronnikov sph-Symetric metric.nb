Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"double t2 = 1/r;\"\>"},
    {"\<\"double t3 = 1/mpar;\"\>"},
    {"\<\"double t5 = pow(qpar,2);\"\>"},
    {"\<\"double t6 = (t2*t3*t5)/2.;\"\>"},
    {"\<\"double t7 = Tanh(t6);\"\>"},
    {"\<\"double t8 = -t7;\"\>"},
    {"\<\"double t9 = 1 + t8;\"\>"},
    {"\<\"double t18 = pow(r,-2);\"\>"},
    {"\<\"double t19 = pow(r,-3);\"\>"},
    {"\<\"double t20 = Sech(t6);\"\>"},
    {"\<\"double t21 = pow(t20,2);\"\>"},
    {"\<\"double t16 = -2*mpar*t2*t9;\"\>"},
    {"\<\"double t17 = 1 + t16;\"\>"},
    {"\<\"double t13 = sin(th);\"\>"},
    {"\<\"double t14 = pow(t13,2);\"\>"},
    {"\<\"double t12 = pow(r,2);\"\>"},
    {"\<\"gtt = -1 + 2*mpar*t2*t9;\"\>"},
    {"\<\"gpp = t12*t14;\"\>"},
    {"\<\"gtp = 0;\"\>"},
    {"\<\"gurr = t17;\"\>"},
    {"\<\"guthth = t18;\"\>"},
    {"\<\"dgttdr = t19*t21*t5 - 2*mpar*t18*t9;\"\>"},
    {"\<\"dgrrdr = -((-(t19*t21*t5) + 2*mpar*t18*t9)/pow(t17,2));\"\>"},
    {"\<\"dgththdr = 2*r;\"\>"},
    {"\<\"dgppdr = 2*r*t14;\"\>"},
    {"\<\"dgtpdr = 0;\"\>"},
    {"\<\"dgttdth = 0;\"\>"},
    {"\<\"dgrrdth = 0;\"\>"},
    {"\<\"dgththdth = 0;\"\>"},
    {"\<\"dgppdth = 2*t12*t13*cos(th);\"\>"},
    {"\<\"dgtpdth = 0;\"\>"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
