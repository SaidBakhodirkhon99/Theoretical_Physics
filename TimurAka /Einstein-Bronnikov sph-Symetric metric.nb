Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"double t2 = 1/r;\"\>"},
    {"\<\"double t3 = 1/mpar;\"\>"},
    {"\<\"double t5 = pow(qpar,2);\"\>"},
    {"\<\"double t6 = (t2*t3*t5)/2.;\"\>"},
    {"\<\"double t7 = Tanh(t6);\"\>"},
    {"\<\"double t8 = -t7;\"\>"},
    {"\<\"double t9 = 1 + t8;\"\>"},
    {"\<\"double t15 = pow(r,2);\"\>"},
    {"\<\"gtt = -1 + 2*mpar*t2*t9;\"\>"},
    {"\<\"grr = 1/(1 - 2*mpar*t2*t9);\"\>"},
    {"\<\"gthth = t15;\"\>"},
    {"\<\"gpp = t15*pow(sin(th),2);\"\>"},
    {"\<\"gtp = 0;\"\>"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{3.989021600352475*^9, 3.989105447643998*^9},
 CellLabel->
