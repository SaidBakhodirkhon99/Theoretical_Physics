Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Riemann", "[", 
    RowBox[{"\[Beta]_", ",", "\[Sigma]_", ",", "\[Mu]_", ",", "\[Nu]_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"Riemann", "[", 
     RowBox[{"\[Beta]", ",", "\[Sigma]", ",", "\[Mu]", ",", "\[Nu]"}], "]"}], 
    "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Christoffel", "[", 
         RowBox[{"\[Beta]", ",", "\[Nu]", ",", "\[Sigma]"}], "]"}], ",", 
        RowBox[{"co", "[", "\[Mu]", "]"}]}], "]"}], "-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Christoffel", "[", 
         RowBox[{"\[Beta]", ",", "\[Mu]", ",", "\[Sigma]"}], "]"}], ",", 
        RowBox[{"co", "[", "\[Nu]", "]"}]}], "]"}], "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Christoffel", "[", 
           RowBox[{"\[Beta]", ",", "\[Mu]", ",", "\[Lambda]"}], "]"}], 
          RowBox[{"Christoffel", "[", 
           RowBox[{"\[Lambda]", ",", "\[Nu]", ",", "\[Sigma]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"Christoffel", "[", 
           RowBox[{"\[Beta]", ",", "\[Nu]", ",", "\[Lambda]"}], "]"}], 
          RowBox[{"Christoffel", "[", 
           RowBox[{"\[Lambda]", ",", "\[Mu]", ",", "\[Sigma]"}], "]"}]}]}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]", ",", "Dim"}], "}"}]}], "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ricci", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Ricci", "[", 
     RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"Riemann", "[", 
        RowBox[{"\[Lambda]", ",", "\[Mu]", ",", "\[Lambda]", ",", "\[Nu]"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]", ",", "Dim"}], "}"}]}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RicciScalar", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Ricci", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], 
       RowBox[{"MetricInverse", "[", 
        RowBox[{"[", 
         RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", 
        RowBox[{"Length", "[", "Coordinates", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "Dim"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]}], "Input",
