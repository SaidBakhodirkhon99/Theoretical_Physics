 RowBox[{
  RowBox[{"Geo", "=", 
   RowBox[{"Array", "[", 
    RowBox[{"geo", ",", "Dim"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"\[Lambda]", "=", "1"}], ",", 
   RowBox[{"\[Lambda]", "<=", "Dim"}], ",", 
   RowBox[{"\[Lambda]", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Geo", "[", 
     RowBox[{"[", "\[Lambda]", "]"}], "]"}], "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"co", "[", "\[Lambda]", "]"}], "[", "PoM", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"PoM", ",", "2"}], "}"}]}], "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Christoffel", "[", 
             RowBox[{"\[Lambda]", ",", "\[Mu]", ",", "\[Nu]"}], "]"}], "/.", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "->", 
                RowBox[{"#", "[", "PoM", "]"}]}], "&"}], "/@", 
              "Coordinates"}], ")"}]}], ")"}], 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"co", "[", "\[Mu]", "]"}], "[", "PoM", "]"}], ",", 
            "PoM"}], "]"}], 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"co", "[", "\[Nu]", "]"}], "[", "PoM", "]"}], ",", 
            "PoM"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "Dim"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Nu]", ",", "Dim"}], "}"}]}], "]"}]}], "==", "0"}], 
     "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "Input",
