Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Riemanndddd", "[", 
    RowBox[{"\[Beta]_", ",", "\[Sigma]_", ",", "\[Mu]_", ",", "\[Nu]_"}], 
    "]"}], 
   RowBox[{"(*", 
    FormBox[
     SubscriptBox["R", "\[Beta]\[Sigma]\[Mu]\[Nu]"],
     TraditionalForm], "*)"}], ":=", 
   RowBox[{
    RowBox[{"Riemanndddd", "[", 
     RowBox[{"\[Beta]", ",", "\[Sigma]", ",", "\[Mu]", ",", "\[Nu]"}], "]"}], 
    "=", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Riemann", "[", 
         RowBox[{"\[Beta]1", ",", "\[Sigma]", ",", "\[Mu]", ",", "\[Nu]"}], 
         "]"}], 
        RowBox[{"Metric", "[", 
         RowBox[{"[", 
          RowBox[{"\[Beta]1", ",", "\[Beta]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Beta]1", ",", "Dim"}], "}"}]}], "]"}], "//", 
     "Simplify"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Riemannuuuu", "[", 
    RowBox[{"\[Beta]_", ",", "\[Sigma]_", ",", "\[Mu]_", ",", "\[Nu]_"}], 
    "]"}], 
   RowBox[{"(*", 
    FormBox[
     SuperscriptBox["R", "\[Beta]\[Sigma]\[Mu]\[Nu]"],
     TraditionalForm], "*)"}], ":=", 
   RowBox[{
    RowBox[{"Riemannuuuu", "[", 
     RowBox[{"\[Beta]", ",", "\[Sigma]", ",", "\[Mu]", ",", "\[Nu]"}], "]"}], 
    "=", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Riemann", "[", 
         RowBox[{"\[Beta]", ",", "\[Sigma]1", ",", "\[Mu]1", ",", "\[Nu]1"}], 
         "]"}], 
        RowBox[{"MetricInverse", "[", 
         RowBox[{"[", 
          RowBox[{"\[Sigma]1", ",", "\[Sigma]"}], "]"}], "]"}], 
        RowBox[{"MetricInverse", "[", 
         RowBox[{"[", 
          RowBox[{"\[Mu]1", ",", "\[Mu]"}], "]"}], "]"}], 
        RowBox[{"MetricInverse", "[", 
         RowBox[{"[", 
          RowBox[{"\[Nu]1", ",", "\[Nu]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Sigma]1", ",", "Dim"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Mu]1", ",", "Dim"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Nu]1", ",", "Dim"}], "}"}]}], "]"}], "//", 
     "Simplify"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Kretschmann", "=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Riemanndddd", "[", 
        RowBox[{"\[Beta]", ",", "\[Sigma]", ",", "\[Mu]", ",", "\[Nu]"}], 
        "]"}], 
       RowBox[{"Riemannuuuu", "[", 
        RowBox[{"\[Beta]", ",", "\[Sigma]", ",", "\[Mu]", ",", "\[Nu]"}], 
        "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", "Dim"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Sigma]", ",", "Dim"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", "Dim"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Nu]", ",", "Dim"}], "}"}]}], "]"}], "//", "Simplify"}]}], 
  ";"}]}], "Input",
