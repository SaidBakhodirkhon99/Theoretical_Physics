Cell[BoxData[
 RowBox[{
  RowBox[{"Christoffel", "[", 
   RowBox[{"\[Beta]_", ",", "\[Mu]_", ",", "\[Nu]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Christoffel", "[", 
    RowBox[{"\[Beta]", ",", "\[Mu]", ",", "\[Nu]"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MetricInverse", "[", 
         RowBox[{"[", 
          RowBox[{"\[Beta]", ",", "\[Alpha]"}], "]"}], "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Metric", "[", 
             RowBox[{"[", 
