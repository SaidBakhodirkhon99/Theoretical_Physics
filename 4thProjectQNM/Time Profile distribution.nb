 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"u", "=", 
        RowBox[{"umin", "+", 
         RowBox[{"i", " ", "h"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"v", "=", 
        RowBox[{"vmin", "+", 
         RowBox[{"j", " ", "h"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rs", "=", 
