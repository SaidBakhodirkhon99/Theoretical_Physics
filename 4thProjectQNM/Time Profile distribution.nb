         RowBox[{"(", 
          RowBox[{"v", "-", "u"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rr", "=", 
        RowBox[{"rOfrs", "[", "rs", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"VS", "=", 
        RowBox[{"Veff", "[", 
         RowBox[{"rr", ",", "l", ",", "\[Mu]", ",", "k", ",", "\[Lambda]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"YS", "=", 
        RowBox[{"Y", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"YE", "=", 
        RowBox[{"Y", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", 
           RowBox[{"j", "+", "1"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"YW", "=", 
        RowBox[{"Y", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"i", "+", "1"}], ",", "j"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Y", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"i", "+", "1"}], ",", 
           RowBox[{"j", "+", "1"}]}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"YE", "+", "YW"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
