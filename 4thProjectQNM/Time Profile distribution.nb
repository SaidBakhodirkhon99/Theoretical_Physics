Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"Metric", " ", "and", " ", "potential"}], "==="}], "*)"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"r_", ",", "k_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", "k"}], ")"}]}], "-", 
    RowBox[{"2", "/", "r"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Lambda]", "/", "r"}], ")"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"r", "/", "\[Lambda]"}], "]"}]}]}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dfdr", "[", 
    RowBox[{"r_", ",", "k_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"2", "/", 
     RowBox[{"r", "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Lambda]", "/", 
       RowBox[{"r", "^", "2"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Log", "[", 
        RowBox[{"r", "/", "\[Lambda]"}], "]"}]}], ")"}]}]}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Veff", "[", 
    RowBox[{"r_", ",", "l_", ",", "\[Mu]_", ",", "k_", ",", "\[Lambda]_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fr", ",", "dfr"}], "}"}], ",", 
     RowBox[{
      RowBox[{"fr", "=", 
       RowBox[{"f", "[", 
        RowBox[{"r", ",", "k", ",", "\[Lambda]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dfr", "=", 
       RowBox[{"dfdr", "[", 
        RowBox[{"r", ",", "k", ",", "\[Lambda]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fr", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"l", " ", 
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}]}], ")"}], "/", 
          RowBox[{"r", "^", "2"}]}], "+", 
         RowBox[{"dfr", "/", "r"}], "+", 
         RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}]}]}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"horizonRadius", "[", 
    RowBox[{"k_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{"r", "/.", " ", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"r", ",", "k", ",", "\[Lambda]"}], "]"}], "==", "0"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "1"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"===", "Parameters", "==="}], "*)"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Mu]", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"l", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", 
   RowBox[{"0.05", "*", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]", "=", "0.0000000002"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"umin", "=", "0"}], ";", 
  RowBox[{"umax", "=", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vmin", "=", 
    RowBox[{"10", "^", 
     RowBox[{"-", "5"}]}]}], ";", 
   RowBox[{"vmax", "=", "200"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"n", "=", "800"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"umax", "-", "umin"}], ")"}], "/", "n"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"Initialize", " ", "grid"}], "==="}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Y", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "+", "1"}], ",", 
        RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"vc", "=", "4.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vl", "=", "2.0"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", "Horizon", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rH", "=", 
    RowBox[{"horizonRadius", "[", 
     RowBox[{"k", ",", "\[Lambda]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Tortoise", " ", "inversion", " ", 
    RowBox[{"(", 
     RowBox[{
     "simple", " ", "shift", " ", "like", " ", "your", " ", "Python", " ", 
      "code"}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rOfrs", "[", "rs_", "]"}], ":=", 
    RowBox[{"rs", "+", "1.654"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"Initial", " ", "Gaussian", " ", "pulse"}], "==="}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"v", "=", 
      RowBox[{"vmin", "+", 
       RowBox[{"j", " ", "h"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Y", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", 
         RowBox[{"j", "+", "1"}]}], "]"}], "]"}], "=", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "10"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"v", "-", "vc"}], ")"}], "^", "2"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Y", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", 
            RowBox[{"j", "+", "1"}]}], "]"}], "]"}], "]"}], "<", 
