         RowBox[{"-", "64"}]}]}], ",", 
       RowBox[{
        RowBox[{"Y", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", 
           RowBox[{"j", "+", "1"}]}], "]"}], "]"}], "=", "0"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
