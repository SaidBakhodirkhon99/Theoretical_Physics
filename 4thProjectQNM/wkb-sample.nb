Cell["freq  vs m ", "Section",
 CellChangeTimes->{{3.9969775321410913`*^9, 
  3.996977562823937*^9}},ExpressionUUID->"138a6657-2f0f-4339-bc6b-\
1d9cd08cf1e3"],

Cell[BoxData[{
 RowBox[{"Omega6", "[", 
  RowBox[{"0.1", ",", 
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]], ",", "2", ",", "0", ",", "0.9"}], "]"}], "\n", 
 RowBox[{"Omega6", "[", 
  RowBox[{"0.1", ",", "0.1", ",", "2", ",", "0", ",", "0.95"}], "]"}], "\n", 
 RowBox[{"Omega6", "[", 
  RowBox[{"0.1", ",", "0.2", ",", "2", ",", "0", ",", "1"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Omega6", "[", 
  RowBox[{"0.1", ",", "0.3", ",", "2", ",", "0", ",", "1"}], "]"}]}], "Input",
 CellChangeTimes->{{3.996977575853229*^9, 3.99697774341051*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"b51ba17e-0275-4b7d-8bf6-7924f6c4d14f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "WKBCheck", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WKBCheck", "[", 
   RowBox[{
    RowBox[{"k0_", "?", "NumericQ"}], ",", 
    RowBox[{"lam0_", "?", "NumericQ"}], ",", "ell0_Integer", ",", 
    "n0_Integer", ",", 
    RowBox[{"mass0_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ff", ",", "vv", ",", "rh", ",", "peak", ",", "rp", ",", "vmax", ",", 
      "vinf", ",", "curvature", ",", "res", ",", "omega6"}], "}"}], ",", 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{"fexpr", "[", 
       RowBox[{"r", ",", "k0", ",", "lam0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vv", "=", 
      RowBox[{"Vexpr", "[", 
       RowBox[{"r", ",", "k0", ",", "lam0", ",", "ell0", ",", "mass0"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Event", " ", "horizon"}], "*)"}], 
     RowBox[{"rh", "=", 
      RowBox[{"r", "/.", " ", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"ff", "==", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "k0"}], ")"}]}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Physical", " ", "barrier", " ", "maximum", " ", "outside", " ", 
       "horizon"}], "*)"}], 
     RowBox[{"peak", "=", 
      RowBox[{"NMaximize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vv", ",", 
          RowBox[{
           RowBox[{"rh", "+", 
            RowBox[{"10", "^", 
             RowBox[{"-", "4"}]}]}], "<", "r", "<", "20"}]}], "}"}], ",", 
        "r"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vmax", "=", 
      RowBox[{"peak", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rp", "=", 
      RowBox[{"r", "/.", " ", 
       RowBox[{"peak", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Asymptotic", " ", "plateau"}], "*)"}], 
     RowBox[{"vinf", "=", 
      RowBox[{
       RowBox[{"mass0", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "k0"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Second", " ", "derivative", " ", "with", " ", "respect", " ", "to", 
       " ", "tortoise", " ", "coordinate"}], "*)"}], 
     RowBox[{"curvature", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"fexpr", "[", 
           RowBox[{"r", ",", "k0", ",", "lam0"}], "]"}], "^", "2"}], "*", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"Vexpr", "[", 
            RowBox[{"r", ",", "k0", ",", "lam0", ",", "ell0", ",", "mass0"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "2"}], "}"}]}], "]"}]}], ")"}], "/.", " ", 
       RowBox[{"r", "->", "rp"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"WKB", " ", "results"}], "*)"}], 
     RowBox[{"res", "=", 
      RowBox[{"WKBFormula", "[", 
       RowBox[{"vv", ",", "ff", ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "rp"}], "}"}], ",", "n0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"omega6", "=", 
      RowBox[{"res", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<rh\>\"", "->", "rh"}], ",", 
       RowBox[{"\"\<rp\>\"", "->", "rp"}], ",", 
       RowBox[{"\"\<Vmax\>\"", "->", "vmax"}], ",", 
       RowBox[{"\"\<Vinf\>\"", "->", "vinf"}], ",", 
       RowBox[{"\"\<Vmax-Vinf\>\"", "->", 
        RowBox[{"vmax", "-", "vinf"}]}], ",", 
       RowBox[{"\"\<VxxPeak\>\"", "->", "curvature"}], ",", 
       RowBox[{"\"\<omega6\>\"", "->", "omega6"}]}], "}"}]}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.996978828673349*^9, 3.996978828675352*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"a58d1fd1-2147-4e02-93e5-a90fa3a3bf02"],

