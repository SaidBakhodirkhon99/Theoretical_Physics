Cell[BoxData[
 RowBox[{
  RowBox[{"WKBCheck", "[", 
   RowBox[{"0.1", ",", "0.000001", ",", "2", ",", "0", ",", "0.7"}], "]"}], "//",
   "TableForm"}]], "Input",
 CellChangeTimes->{{3.996978554681357*^9, 3.9969785701911163`*^9}, {
  3.996978835754616*^9, 3.996978913663526*^9}},
