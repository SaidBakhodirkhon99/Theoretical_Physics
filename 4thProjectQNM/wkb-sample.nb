  RowBox[{
   RowBox[{"fn", "[", "r_", "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{
     FractionBox["2", "r"], 
     RowBox[{"Exp", "[", 
      RowBox[{"-", 
