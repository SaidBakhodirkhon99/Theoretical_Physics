Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fexpr", "[", 
     RowBox[{"r_", ",", "k_", ",", "lam_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", "k"}], ")"}]}], "-", 
     RowBox[{"2", "/", "r"}], "+", 
     RowBox[{
      RowBox[{"lam", "/", "r"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"r", "/", "lam"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Vexpr", "[", 
     RowBox[{"r_", ",", "k_", ",", "lam_", ",", "ell_", ",", "mass_"}], "]"}],
     ":=", 
    RowBox[{
     RowBox[{"fexpr", "[", 
      RowBox[{"r", ",", "k", ",", "lam"}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ell", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ell", "+", "1"}], ")"}], "/", 
         RowBox[{"r", "^", "2"}]}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"fexpr", "[", 
             RowBox[{"x", ",", "k", ",", "lam"}], "]"}], ",", "x"}], "]"}], "/.",
           " ", 
          RowBox[{"x", "->", "r"}]}], ")"}], "/", "r"}], "+", 
       RowBox[{"mass", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Omega6", "[", 
   RowBox[{
    RowBox[{"k0_", "?", "NumericQ"}], ",", 
    RowBox[{"lam0_", "?", "NumericQ"}], ",", "ell0_Integer", ",", 
    "n0_Integer", ",", 
    RowBox[{"mass0_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ff", ",", "vv", ",", "rh", ",", "peak", ",", "rp", ",", "res"}],
      "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{"Metric", " ", "function"}], "*)"}], 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{"fexpr", "[", 
       RowBox[{"r", ",", "k0", ",", "lam0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Effective", " ", "potential"}], "*)"}], 
     RowBox[{"vv", "=", 
      RowBox[{"Vexpr", "[", 
       RowBox[{"r", ",", "k0", ",", "lam0", ",", "ell0", ",", "mass0"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"1.", " ", "Event", " ", "horizon"}], "*)"}], 
     RowBox[{"rh", "=", 
      RowBox[{"r", "/.", " ", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"ff", "==", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "k0"}], ")"}]}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Physical", " ", "potential", " ", "maximum", " ", "OUTSIDE",
        " ", "the", " ", "horizon"}], "*)"}], 
     RowBox[{"peak", "=", 
      RowBox[{"NMaximize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vv", ",", 
          RowBox[{
           RowBox[{"rh", "+", 
            RowBox[{"10", "^", 
             RowBox[{"-", "4"}]}]}], "<", "r", "<", "20"}]}], "}"}], ",", 
        "r"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rp", "=", 
      RowBox[{"r", "/.", " ", 
       RowBox[{"peak", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"3.", " ", "Sixth"}], "-", 
       RowBox[{"order", " ", "WKB"}]}], "*)"}], 
     RowBox[{"res", "=", 
      RowBox[{"WKBFormula", "[", 
       RowBox[{"vv", ",", "ff", ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "rp"}], "}"}], ",", "n0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"First", " ", "element"}], "=", 
       RowBox[{"sixth", "-", 
        RowBox[{"order", " ", "WKB"}]}]}], "*)"}], 
     RowBox[{"res", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.996934368380362*^9, 3.996934368382944*^9}, {
