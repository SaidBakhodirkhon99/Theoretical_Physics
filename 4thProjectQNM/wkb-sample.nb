Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "Omega6", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Omega6", "[", 
   RowBox[{
    RowBox[{"k0_", "?", "NumericQ"}], ",", 
    RowBox[{"lam0_", "?", "NumericQ"}], ",", "ell0_Integer", ",", 
    "n0_Integer", ",", 
    RowBox[{"mass0_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ff", ",", "vv", ",", "rh", ",", "peak", ",", "rp", ",", "res"}],
      "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{"Metric", " ", "function"}], "*)"}], 
    RowBox[{
     RowBox[{"ff", "=", 
      RowBox[{"fexpr", "[", 
       RowBox[{"r", ",", "k0", ",", "lam0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Effective", " ", "potential"}], "*)"}], 
     RowBox[{"vv", "=", 
      RowBox[{"Vexpr", "[", 
       RowBox[{"r", ",", "k0", ",", "lam0", ",", "ell0", ",", "mass0"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"1.", " ", "Event", " ", "horizon"}], "*)"}], 
     RowBox[{"rh", "=", 
      RowBox[{"r", "/.", " ", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"ff", "==", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "k0"}], ")"}]}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Physical", " ", "potential", " ", "maximum", " ", "OUTSIDE",
        " ", "the", " ", "horizon"}], "*)"}], 
     RowBox[{"peak", "=", 
      RowBox[{"NMaximize", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vv", ",", 
          RowBox[{
           RowBox[{"rh", "+", 
            RowBox[{"10", "^", 
             RowBox[{"-", "4"}]}]}], "<", "r", "<", "20"}]}], "}"}], ",", 
        "r"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rp", "=", 
      RowBox[{"r", "/.", " ", 
       RowBox[{"peak", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"3.", " ", "Sixth"}], "-", 
       RowBox[{"order", " ", "WKB"}]}], "*)"}], 
     RowBox[{"res", "=", 
      RowBox[{"WKBFormula", "[", 
       RowBox[{"vv", ",", "ff", ",", 
        RowBox[{"{", 
