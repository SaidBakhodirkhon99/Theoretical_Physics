      FractionBox[
       RowBox[{
        RowBox[{"fn", "'"}], "[", "r", "]"}], "r"], "+", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[Mu]", "2"], "-", 
        RowBox[{"m", " ", 
         SuperscriptBox["\[Omega]", "2"], 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"2", "a"}], 
            SuperscriptBox["r", "2"]]}], ")"}]}]}], ")"}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"2", " ", 
