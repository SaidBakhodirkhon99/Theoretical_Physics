  "In[113]:=",ExpressionUUID->"05131eba-fff6-4121-8e1a-985620e5eab5"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      RowBox[{"\<\"rh\"\>", "\[Rule]", "1.7999870370389808`"}]},
     {
      RowBox[{"\<\"rp\"\>", "\[Rule]", "3.40426420464047`"}]},
     {
