  0.85],ExpressionUUID->"59166905-9f93-47bd-a850-5ce33d3e60fa"],

Cell[CellGroupData[{

Cell["Definitions", "Section",
 CellChangeTimes->{{3.701401045320799*^9, 3.701401047800737*^9}, {
  3.713772725782699*^9, 
  3.713772729509159*^9}},ExpressionUUID->"2767dd18-09db-431c-9ebe-\
36079cf98105"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{"-", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "r_", "]"}], "=", 
   RowBox[{"1", "-", 
    FractionBox["2", "r"]}]}], ";", 
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"r_", ",", "l_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"f", "[", "r", "]"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"l", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}]}], 
       SuperscriptBox["r", "2"]], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"f", "'"}], "[", "r", "]"}], "r"], "+", 
      SuperscriptBox["\[Mu]", "2"], "-", 
      RowBox[{"m", " ", "qB"}]}], " ", ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fr", "[", "rs_", "]"}], ":=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", 
      RowBox[{"rs", "\[GreaterEqual]", 
       RowBox[{"-", "150"}]}], "]"}], ",", 
     RowBox[{"x", "/.", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"rs", "\[Equal]", 
         RowBox[{"x", "+", 
          RowBox[{"2", 
           RowBox[{"Log", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{
