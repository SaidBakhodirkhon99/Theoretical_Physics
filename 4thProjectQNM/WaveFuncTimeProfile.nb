Cell[CellGroupData[{

Cell["GR WAVE -  temporal evolution m=1 ", "Title",
 CellChangeTimes->{{3.701400078795822*^9, 3.70140009034995*^9}, {
  3.7138066895831423`*^9, 3.713806690789056*^9}, {3.739153341945841*^9, 
  3.739153439780637*^9}, {3.739159875261413*^9, 3.73915987608954*^9}},
 FontFamily->"FreeSerif",
 FontSize->48,
