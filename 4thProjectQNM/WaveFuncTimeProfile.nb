  3.701401134971078*^9}},ExpressionUUID->"33478df7-a2ec-47d9-8dee-\
a5d2eed77718"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"v", "=", 
      RowBox[{"vmin", "+", 
       RowBox[{"j", "*", "h"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Y", "[", 
       RowBox[{"0", ",", "j"}], "]"}], "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"10", "^", "1"}]}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v", "-", "vc"}], ")"}], "^", "2"}]}], "]"}], ",", "64"}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Y", "[", 
           RowBox[{"0", ",", "j"}], "]"}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "64"}]}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"Y", "[", 
         RowBox[{"0", ",", "j"}], "]"}], "=", "0"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Y", "[", 
       RowBox[{"j", ",", "j"}], "]"}], "=", "0"}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", "n"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "=", 
     RowBox[{"umin", "+", 
      RowBox[{"i", "*", "h"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "=", 
        RowBox[{"vmin", "+", 
         RowBox[{"j", "*", "h"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rrs", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"v", "-", "u"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rr", "=", 
        RowBox[{"fr", "[", "rrs", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"YS", "=", 
        RowBox[{"Y", "[", 
         RowBox[{
          RowBox[{"i", "-", "1"}], ",", 
          RowBox[{"j", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"YE", "=", 
        RowBox[{"Y", "[", 
         RowBox[{
          RowBox[{"i", "-", "1"}], ",", "j"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"YW", "=", 
        RowBox[{"Y", "[", 
         RowBox[{"i", ",", 
          RowBox[{"j", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"VS", "=", 
        RowBox[{"V", "[", 
         RowBox[{"rr", ",", "vl"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Y", "[", 
         RowBox[{"i", ",", "j"}], "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"YE", "+", "YW"}], ")"}], "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"16", "-", 
             RowBox[{
              RowBox[{"h", "^", "2"}], "*", "VS"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"16", "+", 
             RowBox[{
              RowBox[{"h", "^", "2"}], "*", "VS"}]}], ")"}]}]}], "-", 
         "YS"}]}], ";"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rs", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data4", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"v", "=", 
     RowBox[{"vmin", "+", 
      RowBox[{"i", "*", "h"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"u", "=", 
     RowBox[{"v", "-", 
      RowBox[{"2", "*", "rs"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"iu", "=", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"u", "-", "umin"}], ")"}], "/", "h"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"iv", "=", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"v", "-", "vmin"}], ")"}], "/", "h"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"iu", "\[GreaterEqual]", "0"}], "&&", 
          RowBox[{"iu", "<", "n"}]}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"iv", "\[GreaterEqual]", "0"}], "&&", 
          RowBox[{"iv", "<", "n"}]}], ")"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"t", "=", 
        RowBox[{"0.5", "*", 
         RowBox[{"(", 
          RowBox[{"u", "+", "v"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"data4", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"data4", ",", 
          RowBox[{"{", 
