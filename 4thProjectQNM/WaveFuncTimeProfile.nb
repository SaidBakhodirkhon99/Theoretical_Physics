  3.713772729509159*^9}},ExpressionUUID->"b835eb94-6911-4d34-af2d-\
0fc34e42ae63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "r_", "]"}], "=", 
   RowBox[{"1", "-", 
    FractionBox["2", "r"]}]}], ";", 
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"r_", ",", "l_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"f", "[", "r", "]"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"l", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}]}], 
       SuperscriptBox["r", "2"]], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"f", "'"}], "[", "r", "]"}], "r"], "+", 
      SuperscriptBox["\[Mu]", "2"], "-", 
      RowBox[{"m", " ", "qB"}]}], " ", ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fr", "[", "rs_", "]"}], ":=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", 
      RowBox[{"rs", "\[GreaterEqual]", 
       RowBox[{"-", "150"}]}], "]"}], ",", 
     RowBox[{"x", "/.", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"rs", "\[Equal]", 
         RowBox[{"x", "+", 
          RowBox[{"2", 
           RowBox[{"Log", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"x", "/", "2"}], "-", "1"}], "]"}], "]"}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"2", "*", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"10", "^", 
              RowBox[{"-", "40"}]}]}], ")"}]}], ",", "2000"}], "}"}], ",", 
        RowBox[{"Method", "\[Rule]", "\"\<Secant\>\""}], ",", 
        RowBox[{"WorkingPrecision", "\[Rule]", "64"}]}], "]"}]}], ",", 
     RowBox[{"TrueQ", "[", 
      RowBox[{"rs", "<", "150"}], "]"}], ",", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"10", "^", 
         RowBox[{"-", "40"}]}]}], ")"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"frs", "[", "r_", "]"}], "=", 
   RowBox[{"r", "+", 
    RowBox[{"2", 
     RowBox[{"Log", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{
        FractionBox["r", "2"], "-", "1"}], "]"}], "]"}]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.7014001285957603`*^9, 3.7014001371754093`*^9}, {
   3.714112546615191*^9, 3.714112551996133*^9}, 3.7390838184055433`*^9, 
