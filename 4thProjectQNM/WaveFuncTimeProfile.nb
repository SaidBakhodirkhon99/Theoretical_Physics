    RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rs", "=", "5"}], ";"}], "\n", 
 RowBox[{
