        RowBox[{"Y", "[", 
         RowBox[{"i", ",", "j"}], "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"YE", "+", "YW"}], ")"}], "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"16", "-", 
             RowBox[{
              RowBox[{"h", "^", "2"}], "*", "VS"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"16", "+", 
             RowBox[{
              RowBox[{"h", "^", "2"}], "*", "VS"}]}], ")"}]}]}], "-", 
         "YS"}]}], ";"}], "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
