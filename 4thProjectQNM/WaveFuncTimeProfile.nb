 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"v", "=", 
     RowBox[{"vmin", "+", 
      RowBox[{"i", "*", "h"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"u", "=", 
     RowBox[{"v", "-", 
      RowBox[{"2", "*", "rs"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"iu", "=", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"u", "-", "umin"}], ")"}], "/", "h"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"iv", "=", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"v", "-", "vmin"}], ")"}], "/", "h"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"iu", "\[GreaterEqual]", "0"}], "&&", 
          RowBox[{"iu", "<", "n"}]}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"iv", "\[GreaterEqual]", "0"}], "&&", 
          RowBox[{"iv", "<", "n"}]}], ")"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"t", "=", 
        RowBox[{"0.5", "*", 
         RowBox[{"(", 
          RowBox[{"u", "+", "v"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"data1", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"data1", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"Y", "[", 
             RowBox[{"iu", ",", "iv"}], "]"}]}], "}"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
