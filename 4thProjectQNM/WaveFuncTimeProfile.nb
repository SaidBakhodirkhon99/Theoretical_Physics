Cell[BoxData[{
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"v", "=", 
      RowBox[{"vmin", "+", 
       RowBox[{"j", "*", "h"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Y", "[", 
       RowBox[{"0", ",", "j"}], "]"}], "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"10", "^", "1"}]}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"v", "-", "vc"}], ")"}], "^", "2"}]}], "]"}], ",", "64"}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Y", "[", 
           RowBox[{"0", ",", "j"}], "]"}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "64"}]}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"Y", "[", 
         RowBox[{"0", ",", "j"}], "]"}], "=", "0"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Y", "[", 
       RowBox[{"j", ",", "j"}], "]"}], "=", "0"}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "0", ",", "n"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "=", 
     RowBox[{"umin", "+", 
      RowBox[{"i", "*", "h"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "=", 
        RowBox[{"vmin", "+", 
         RowBox[{"j", "*", "h"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rrs", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"v", "-", "u"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rr", "=", 
        RowBox[{"fr", "[", "rrs", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"YS", "=", 
        RowBox[{"Y", "[", 
         RowBox[{
          RowBox[{"i", "-", "1"}], ",", 
          RowBox[{"j", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"YE", "=", 
        RowBox[{"Y", "[", 
         RowBox[{
          RowBox[{"i", "-", "1"}], ",", "j"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"YW", "=", 
        RowBox[{"Y", "[", 
         RowBox[{"i", ",", 
          RowBox[{"j", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"VS", "=", 
        RowBox[{"V", "[", 
