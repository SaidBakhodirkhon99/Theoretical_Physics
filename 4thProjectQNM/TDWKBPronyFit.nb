Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M", "=", "1."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k0", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lam0", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ell0", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mass0", "=", "0.2"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", "k0"}], ")"}]}], "-", 
     RowBox[{"2", " ", 
      RowBox[{"M", "/", "r"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"lam0", "/", "r"}], ")"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"r", "/", "lam0"}], "]"}]}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fp", "[", 
     RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"M", "/", 
       RowBox[{"r", "^", "2"}]}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"lam0", "/", 
        RowBox[{"r", "^", "2"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Log", "[", 
         RowBox[{"r", "/", "lam0"}], "]"}]}], ")"}]}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Veff", "[", 
    RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"f", "[", "r", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ell0", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ell0", "+", "1"}], ")"}], "/", 
        RowBox[{"r", "^", "2"}]}]}], "+", 
      RowBox[{
       RowBox[{"fp", "[", "r", "]"}], "/", "r"}], "+", 
      RowBox[{"mass0", "^", "2"}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.997059165167788*^9, 3.997059165169931*^9}},
 CellLabel->
  "In[574]:=",ExpressionUUID->"7c0f5212-cb86-4431-8eef-4d00b5ea1af6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rh", "=", 
    RowBox[{"r", "/.", " ", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "r", "]"}], "==", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "1.5"}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"N", "[", 
  RowBox[{"rh", ",", "12"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"f", "[", "rh", "]"}]}], "Input",
