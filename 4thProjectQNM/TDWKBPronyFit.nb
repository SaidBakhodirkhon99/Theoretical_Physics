Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "waveDifference", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"waveDifference", "[", 
   RowBox[{"dataCoarse_", ",", "dataFine_", ",", "t1_", ",", "t2_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"coarse", ",", "fineInterp", ",", "diff"}], "}"}], ",", 
    RowBox[{
     RowBox[{"coarse", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"dataCoarse", ",", 
        RowBox[{
         RowBox[{"t1", "<=", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<=", "t2"}], "&"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"fineInterp", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"dataFine", ",", 
        RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"diff", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"coarse", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
         RowBox[{"fineInterp", "[", 
          RowBox[{"coarse", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "coarse", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Mean", "[", 
       RowBox[{"diff", "^", "2"}], "]"}], "]"}]}]}], "]"}]}]}], "Input",
