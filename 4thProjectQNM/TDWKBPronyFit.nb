Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "getOscillatoryModes", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"getOscillatoryModes", "[", 
   RowBox[{"data_", ",", "t1_", ",", "t2_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mpTmp", ",", "modes"}], "}"}], ",", 
    RowBox[{
     RowBox[{"mpTmp", "=", 
      RowBox[{"matrixPencilQNM", "[", 
       RowBox[{"data", ",", "t1", ",", "t2", ",", "4"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"modes", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"mpTmp", "[", "\"\<Exponents\>\"", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Re", "[", "#", "]"}], "<", "0"}], "&&", 
          RowBox[{
           RowBox[{"Im", "[", "#", "]"}], ">", "0"}]}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Re", "[", "m", "]"}]}], ",", 
           RowBox[{"Im", "[", "m", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "modes"}], "}"}]}], "]"}], ",", "Last"}], 
      "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.997104107206085*^9, 3.9971041072084227`*^9}},
