Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "matrixPencilReconstruction", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"matrixPencilReconstruction", "[", 
   RowBox[{"data_", ",", "t1_", ",", "t2_", ",", 
    RowBox[{"rank_", ":", "4"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fitData", ",", "times", ",", "y", ",", "t0", ",", "mp", ",", "sModes", 
      ",", "design", ",", "amps", ",", "yFit", ",", "residual", ",", 
      "rmsResidual", ",", "relativeRMS"}], "}"}], ",", 
    RowBox[{
     RowBox[{"fitData", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"data", ",", 
        RowBox[{
         RowBox[{"t1", "<=", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<=", "t2"}], "&"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"times", "=", 
      RowBox[{"fitData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"fitData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"t0", "=", 
      RowBox[{"First", "[", "times", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"mp", "=", 
      RowBox[{"matrixPencilQNM", "[", 
       RowBox[{"data", ",", "t1", ",", "t2", ",", "rank"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sModes", "=", 
      RowBox[{"mp", "[", "\"\<Exponents\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"modal", " ", 
        RowBox[{"model", ":", 
         RowBox[{"Psi", 
          RowBox[{"(", "t", ")"}]}]}]}], "=", 
       RowBox[{"Sum", "[", 
        RowBox[{"A_j", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"s_j", " ", 
           RowBox[{"(", 
            RowBox[{"t", "-", "t0"}], ")"}]}], "]"}]}], "]"}]}], "*)"}], 
     RowBox[{"design", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"sModes", "[", 
           RowBox[{"[", "j", "]"}], "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"times", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", "t0"}], ")"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "times", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", "sModes", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"least", "-", 
       RowBox[{"squares", " ", "amplitudes"}]}], "*)"}], 
     RowBox[{"amps", "=", 
      RowBox[{"LeastSquares", "[", 
       RowBox[{"design", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"yFit", "=", 
      RowBox[{"Re", "[", 
       RowBox[{"design", ".", "amps"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"residual", "=", 
      RowBox[{"y", "-", "yFit"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rmsResidual", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{"residual", "^", "2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"relativeRMS", "=", 
      RowBox[{"rmsResidual", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Mean", "[", 
         RowBox[{"y", "^", "2"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Modes\>\"", "->", "sModes"}], ",", 
       RowBox[{"\"\<Amplitudes\>\"", "->", "amps"}], ",", 
       RowBox[{"\"\<FitData\>\"", "->", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"times", ",", "yFit"}], "}"}], "]"}]}], ",", 
       RowBox[{"\"\<ResidualData\>\"", "->", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"times", ",", "residual"}], "}"}], "]"}]}], ",", 
       RowBox[{"\"\<RMSResidual\>\"", "->", "rmsResidual"}], ",", 
       RowBox[{"\"\<RelativeRMS\>\"", "->", "relativeRMS"}]}], "|>"}]}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.997104245434251*^9, 3.997104245436068*^9}},
 CellLabel->
  "In[748]:=",ExpressionUUID->"691afd0f-392b-4f29-b26c-d5ea8bd698d8"],

