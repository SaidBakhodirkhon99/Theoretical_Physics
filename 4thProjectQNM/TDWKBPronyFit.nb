Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"high", "-", 
    RowBox[{"resolution", " ", "signed", " ", "waveform"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"times", "=", 
     RowBox[{"wave0125", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vals", "=", 
     RowBox[{"wave0125", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"local", " ", "maxima", " ", "of"}], "|", "Psi", "|"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakIndices", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"2", ",", 
         RowBox[{
          RowBox[{"Length", "[", "vals", "]"}], "-", "1"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"vals", "[", 
            RowBox[{"[", "#", "]"}], "]"}], "]"}], ">", 
          RowBox[{"Abs", "[", 
           RowBox[{"vals", "[", 
            RowBox[{"[", 
             RowBox[{"#", "-", "1"}], "]"}], "]"}], "]"}]}], "&&", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"vals", "[", 
            RowBox[{"[", "#", "]"}], "]"}], "]"}], ">", 
          RowBox[{"Abs", "[", 
