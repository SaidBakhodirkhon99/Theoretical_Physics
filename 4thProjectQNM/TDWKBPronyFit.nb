Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"rr", ",", "rOfRs"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"rsMin", "=", 
   RowBox[{"-", "30."}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rsMax", "=", "50."}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rRef", "=", "10."}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rSolution", "=", 
    RowBox[{"NDSolveValue", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"rr", "'"}], "[", "x", "]"}], "==", 
         RowBox[{"f", "[", 
          RowBox[{"rr", "[", "x", "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"rr", "[", "0", "]"}], "==", "rRef"}]}], "}"}], ",", "rr", 
      ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "rsMin", ",", "rsMax"}], "}"}], ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<TimeIntegration\>\"", "->", 
         RowBox[{"{", "\"\<ExplicitRungeKutta\>\"", "}"}]}], "}"}]}], ",", 
      RowBox[{"AccuracyGoal", "->", "12"}], ",", 
      RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rOfRs", "[", 
    RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
