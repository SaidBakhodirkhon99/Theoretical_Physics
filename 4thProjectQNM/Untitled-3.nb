   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rhBH", "[", 
      RowBox[{"lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{"N", "[", 
      RowBox[{"lam", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "k"}], ")"}], " ", 
       RowBox[{"ProductLog", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
