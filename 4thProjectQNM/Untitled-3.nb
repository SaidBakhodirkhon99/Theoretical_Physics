Cell[CellGroupData[{

Cell["\<\
GBFactor for k{0.1, 0.2, 0.3, 0.4} values new Code rainbow stayle\
\>", "Section",
 CellChangeTimes->{{3.991882917690782*^9, 3.991882941488029*^9}, {
  3.991945515719136*^9, 
  3.991945528456441*^9}},ExpressionUUID->"600e2a49-c33f-4b1e-95fc-\
6e81a0c751c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"<<", "MaTeX`"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], "\n", 
   RowBox[{"(*", "Parameters", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Mval", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lval", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"fixed", " ", "lambda"}], ",", 
     RowBox[{"varying", " ", "k"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"lambdaVal", "=", "0.1"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kValues", "=", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", "0.2", ",", "0.3", ",", "0.4"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Metric", " ", "function"}], "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fBH", "[", 
      RowBox[{"r_", ",", "lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "k"}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "M"}], ")"}], "/", "r"}], "+", 
      RowBox[{
       RowBox[{"lam", "/", "r"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"r", "/", "lam"}], "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fpBH", "[", 
      RowBox[{"r_", ",", "lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"M", "/", 
        RowBox[{"r", "^", "2"}]}]}], "+", 
      RowBox[{"lam", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Log", "[", 
           RowBox[{"r", "/", "lam"}], "]"}]}], ")"}], "/", 
        RowBox[{"r", "^", "2"}]}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Scalar", " ", "perturbation", " ", "potential"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VBH", "[", 
      RowBox[{"r_", ",", "l_", ",", "lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{"Simplify", "[", 
