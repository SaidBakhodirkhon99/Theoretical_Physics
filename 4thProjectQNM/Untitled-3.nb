            ",", 
            RowBox[{"MaxIterations", "->", "200"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"N", "[", "root", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
