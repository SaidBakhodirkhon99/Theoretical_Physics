Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Direct", " ", "numerical", " ", "scattering"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "DirectScatter", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DirectScatter", "[", 
     RowBox[{
      RowBox[{"omega_", "?", "NumericQ"}], ",", 
      RowBox[{"lam_", "?", "NumericQ"}], ",", 
      RowBox[{"k_", "?", "NumericQ"}], ",", "l_Integer", ",", 
      RowBox[{"M_", "?", "NumericQ"}], ",", 
      RowBox[{"rMax_", ":", "400"}], ",", 
      RowBox[{"eps_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rh", ",", "r0", ",", "omegaTh", ",", "chi", ",", "xMax", ",", "sol", 
        ",", "xf", ",", "rf", ",", "psiF", ",", "qF", ",", "p", ",", "p2", 
        ",", "dVdr", ",", "dpdr", ",", "dpdx", ",", "yIn", ",", "yOut", ",", 
        "qIn", ",", "qOut", ",", "coeff", ",", "AIn", ",", "AOut", ",", 
        "gammaFlux", ",", "gammaReflection", ",", "reflection", ",", 
        "fluxError"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"m", "=", 
        RowBox[{
        "0.2", " ", "is", " ", "already", " ", "built", " ", "into", " ", 
         "VBH"}]}], "*)"}], 
      RowBox[{
       RowBox[{"omegaTh", "=", 
        RowBox[{"0.2", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", "k"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"omega", "<=", "omegaTh"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Physical\>\"", "->", "False"}], ",", 
            RowBox[{"\"\<Threshold\>\"", "->", "omegaTh"}]}], "|>"}], "]"}]}],
         "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"chi", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"omega", "^", "2"}], "-", 
          RowBox[{
           RowBox[{"0.2", "^", "2"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", "-", "k"}], ")"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rh", "=", 
        RowBox[{"rhBH", "[", 
         RowBox[{"lam", ",", "k", ",", "M"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"r0", "=", 
        RowBox[{"rh", "+", "eps"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xMax", "=", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", "k"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"rMax", "-", "r0"}], ")"}]}], "+", "100"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"rr", "'"}], "[", "x", "]"}], "==", 
             RowBox[{"fBH", "[", 
              RowBox[{
               RowBox[{"rr", "[", "x", "]"}], ",", "lam", ",", "k", ",", 
               "M"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"psi", "'"}], "[", "x", "]"}], "==", 
             RowBox[{"q", "[", "x", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"q", "'"}], "[", "x", "]"}], "==", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"omega", "^", "2"}], "-", 
                 RowBox[{"VBH", "[", 
                  RowBox[{
                   RowBox[{"rr", "[", "x", "]"}], ",", "l", ",", "lam", ",", 
                   "k", ",", "M"}], "]"}]}], ")"}]}], " ", 
              RowBox[{"psi", "[", "x", "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"rr", "[", "0", "]"}], "==", "r0"}], ",", 
            RowBox[{
             RowBox[{"psi", "[", "0", "]"}], "==", 
             RowBox[{"1", "+", 
              RowBox[{"0", " ", "I"}]}]}], ",", 
            RowBox[{
             RowBox[{"q", "[", "0", "]"}], "==", 
             RowBox[{
              RowBox[{"-", "I"}], " ", "omega"}]}], ",", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"rr", "[", "x", "]"}], ">=", "rMax"}], ",", 
              "\"\<StopIntegration\>\""}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"rr", ",", "psi", ",", "q"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "xMax"}], "}"}], ",", 
          RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xf", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Domain\>\"", "]"}], "[", 
         
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rf", "=", 
        RowBox[{
         RowBox[{"sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", "xf", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"psiF", "=", 
        RowBox[{
         RowBox[{"sol", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "[", "xf", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qF", "=", 
        RowBox[{
         RowBox[{"sol", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "[", "xf", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"local", " ", "asymptotic", " ", "momentum"}], "*)"}], 
       RowBox[{"p2", "=", 
        RowBox[{
         RowBox[{"omega", "^", "2"}], "-", 
         RowBox[{"VBH", "[", 
          RowBox[{"rf", ",", "l", ",", "lam", ",", "k", ",", "M"}], "]"}]}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Re", "[", "p2", "]"}], "<=", "0"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Physical\>\"", "->", "False"}], ",", 
            RowBox[{
            "\"\<Reason\>\"", "->", 
             "\"\<Matching point not yet propagating\>\""}], ",", 
            RowBox[{"\"\<rFinal\>\"", "->", "rf"}]}], "|>"}], "]"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{"Sqrt", "[", "p2", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"derivative", " ", "of", " ", "potential"}], "*)"}], 
       RowBox[{"dVdr", "=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"VBH", "[", 
             RowBox[{"z", ",", "l", ",", "lam", ",", "k", ",", "M"}], "]"}], 
            ",", "z"}], "]"}], "/.", " ", 
          RowBox[{"z", "->", "rf"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dpdr", "=", 
        RowBox[{
         RowBox[{"-", "dVdr"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "p"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dpdx", "=", 
        RowBox[{
         RowBox[{"fBH", "[", 
          RowBox[{"rf", ",", "lam", ",", "k", ",", "M"}], "]"}], " ", 
         "dpdr"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"flux", "-", 
         RowBox[{"normalized", " ", "WKB", " ", "basis"}]}], "*)"}], 
       RowBox[{"yIn", "=", 
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "p", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"yOut", "=", 
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "p", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"qIn", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "I"}], " ", "p"}], "-", 
           RowBox[{"dpdx", "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "p"}], ")"}]}]}], ")"}], " ", "yIn"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"qOut", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"I", " ", "p"}], "-", 
           RowBox[{"dpdx", "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "p"}], ")"}]}]}], ")"}], " ", "yOut"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coeff", "=", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"yIn", ",", "yOut"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"qIn", ",", "qOut"}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"psiF", ",", "qF"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AIn", "=", 
        RowBox[{"coeff", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"AOut", "=", 
        RowBox[{"coeff", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"reflection", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "AOut", "]"}], "^", "2"}], "/", 
         RowBox[{
          RowBox[{"Abs", "[", "AIn", "]"}], "^", "2"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "because", " ", "horizon", " ", "amplitude", " ", "was", " ", 
         "normalized", " ", "to", " ", "1"}], "*)"}], 
       RowBox[{"gammaFlux", "=", 
        RowBox[{"omega", "/", 
         RowBox[{
          RowBox[{"Abs", "[", "AIn", "]"}], "^", "2"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gammaReflection", "=", 
        RowBox[{"1", "-", "reflection"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fluxError", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"gammaFlux", "-", "gammaReflection"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Physical\>\"", "->", "True"}], ",", 
         RowBox[{"\"\<Omega\>\"", "->", "omega"}], ",", 
         RowBox[{"\"\<Threshold\>\"", "->", "omegaTh"}], ",", 
         RowBox[{"\"\<Chi\>\"", "->", "chi"}], ",", 
         RowBox[{"\"\<rHorizon\>\"", "->", "rh"}], ",", 
         RowBox[{"\"\<rFinal\>\"", "->", "rf"}], ",", 
         RowBox[{"\"\<AIn\>\"", "->", "AIn"}], ",", 
         RowBox[{"\"\<AOut\>\"", "->", "AOut"}], ",", 
         RowBox[{"\"\<Reflection\>\"", "->", "reflection"}], ",", 
         RowBox[{"\"\<GammaFlux\>\"", "->", "gammaFlux"}], ",", 
         RowBox[{"\"\<GammaReflection\>\"", "->", "gammaReflection"}], ",", 
         RowBox[{"\"\<FluxError\>\"", "->", "fluxError"}]}], "|>"}]}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.997489050073235*^9, 3.9974890500751457`*^9}},
 CellLabel->
  "In[2340]:=",ExpressionUUID->"83c54078-aabd-431f-8bf6-968d2f9c4db6"],

