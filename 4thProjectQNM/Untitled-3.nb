Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"<<", "MaTeX`"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "Parameters", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Mval", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lval", "=", "1"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"fixed", " ", "lambda"}], ",", 
     RowBox[{"varying", " ", "k"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lambdaVal", "=", "0.1"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"kValues", "=", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", "0.2", ",", "0.3", ",", "0.4"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Metric", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fBH", "[", 
      RowBox[{"r_", ",", "lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "k"}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "M"}], ")"}], "/", "r"}], "+", 
      RowBox[{
       RowBox[{"lam", "/", "r"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"r", "/", "lam"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fpBH", "[", 
      RowBox[{"r_", ",", "lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"M", "/", 
        RowBox[{"r", "^", "2"}]}]}], "+", 
      RowBox[{"lam", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Log", "[", 
           RowBox[{"r", "/", "lam"}], "]"}]}], ")"}], "/", 
        RowBox[{"r", "^", "2"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Scalar", " ", "perturbation", " ", "potential"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"VBH", "[", 
      RowBox[{"r_", ",", "l_", ",", "lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"fBH", "[", 
        RowBox[{"r", ",", "lam", ",", "k", ",", "M"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"l", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "+", "1"}], ")"}], "/", 
           RowBox[{"r", "^", "2"}]}]}], "+", 
         RowBox[{
          RowBox[{"fpBH", "[", 
           RowBox[{"r", ",", "lam", ",", "k", ",", "M"}], "]"}], "/", "r"}]}],
         ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Event", " ", "horizon"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rhBH", "[", 
      RowBox[{"lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{"N", "[", 
      RowBox[{"lam", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", "k"}], ")"}], " ", 
       RowBox[{"ProductLog", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"2", " ", 
           RowBox[{"M", "/", "lam"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"1", "-", "k"}], ")"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Position", " ", "of", " ", "potential", " ", "maximum"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rPeakBH", "[", 
      RowBox[{"lam_", ",", "l_Integer", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "lamN", ",", "kN", ",", "MN", ",", "rh", ",", "rmin", ",", "rmax", 
         ",", "ngrid", ",", "grid", ",", "vals", ",", "imax", ",", "rleft", 
         ",", "rmid", ",", "rright", ",", "dVexpr", ",", "root"}], "}"}], ",", 
       RowBox[{
        RowBox[{"lamN", "=", 
         RowBox[{"N", "[", "lam", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"kN", "=", 
         RowBox[{"N", "[", "k", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"MN", "=", 
         RowBox[{"N", "[", "M", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rh", "=", 
         RowBox[{"rhBH", "[", 
          RowBox[{"lamN", ",", "kN", ",", "MN"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rmin", "=", 
         RowBox[{"rh", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"10", "^", 
             RowBox[{"-", "8"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rmax", "=", 
         RowBox[{"100", " ", "MN"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ngrid", "=", "800"}], ";", "\[IndentingNewLine]", 
        RowBox[{"grid", "=", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"rmin", ",", "rmax", ",", "ngrid"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vals", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"VBH", "[", 
            RowBox[{"#", ",", "l", ",", "lamN", ",", "kN", ",", "MN"}], "]"}],
            "&"}], "/@", "grid"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"imax", "=", 
         RowBox[{"First", "[", 
          RowBox[{"Ordering", "[", 
           RowBox[{"vals", ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"imax", "==", "1"}], "||", 
           RowBox[{"imax", "==", 
            RowBox[{"Length", "[", "grid", "]"}]}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<Warning: maximum at boundary\>\"", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", 
            RowBox[{"grid", "[", 
             RowBox[{"[", "imax", "]"}], "]"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rleft", "=", 
         RowBox[{"grid", "[", 
          RowBox[{"[", 
           RowBox[{"imax", "-", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rmid", "=", 
         RowBox[{"grid", "[", 
          RowBox[{"[", "imax", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rright", "=", 
         RowBox[{"grid", "[", 
          RowBox[{"[", 
           RowBox[{"imax", "+", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dVexpr", "=", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"VBH", "[", 
            RowBox[{"r", ",", "l", ",", "lamN", ",", "kN", ",", "MN"}], "]"}],
            ",", "r"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"root", "=", 
         RowBox[{"r", "/.", " ", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{"dVexpr", "==", "0"}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "rmid", ",", "rleft", ",", "rright"}], "}"}], 
            ",", 
            RowBox[{"MaxIterations", "->", "200"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"N", "[", "root", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Third", "-", 
     RowBox[{"order", " ", "WKB", " ", "QNM"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"QNMFrequency", "[", 
      RowBox[{
      "lam_", ",", "n_Integer", ",", "l_Integer", ",", "k_", ",", "M_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "lamN", ",", "kN", ",", "MN", ",", "b", ",", "r0", ",", "fexpr", ",", 
         "Vexpr", ",", "ders", ",", "V0", ",", "V1", ",", "V2", ",", "V3", 
         ",", "V4", ",", "V5", ",", "V6", ",", "S", ",", "part1", ",", 
         "part2", ",", "omega2", ",", "omegaPlus", ",", "omegaMinus"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"lamN", "=", 
         RowBox[{"N", "[", "lam", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"kN", "=", 
         RowBox[{"N", "[", "k", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"MN", "=", 
         RowBox[{"N", "[", "M", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"b", "=", 
         RowBox[{"N", "[", 
          RowBox[{"n", "+", 
           RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"r0", "=", 
         RowBox[{"rPeakBH", "[", 
          RowBox[{"lamN", ",", "l", ",", "kN", ",", "MN"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fexpr", "=", 
         RowBox[{"fBH", "[", 
          RowBox[{"r", ",", "lamN", ",", "kN", ",", "MN"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Vexpr", "=", 
         RowBox[{"VBH", "[", 
          RowBox[{"r", ",", "l", ",", "lamN", ",", "kN", ",", "MN"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"ders", "=", 
         RowBox[{"NestList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Simplify", "[", 
             RowBox[{"fexpr", " ", 
              RowBox[{"D", "[", 
               RowBox[{"#", ",", "r"}], "]"}]}], "]"}], "&"}], ",", "Vexpr", 
           ",", "6"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "V0", ",", "V1", ",", "V2", ",", "V3", ",", "V4", ",", "V5", ",", 
           "V6"}], "}"}], "=", 
         RowBox[{"N", "[", 
          RowBox[{"ders", "/.", " ", 
           RowBox[{"r", "->", "r0"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"S", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"-", "2"}], " ", "V2"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"part1", "=", 
         RowBox[{"I", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
