            ",", "r"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"root", "=", 
         RowBox[{"r", "/.", " ", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{"dVexpr", "==", "0"}], ",", 
            RowBox[{"{", 
