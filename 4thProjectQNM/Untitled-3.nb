   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rPeakBH", "[", 
      RowBox[{"lam_", ",", "l_Integer", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "lamN", ",", "kN", ",", "MN", ",", "rh", ",", "rmin", ",", "rmax", 
         ",", "ngrid", ",", "grid", ",", "vals", ",", "imax", ",", "rleft", 
         ",", "rmid", ",", "rright", ",", "dVexpr", ",", "root"}], "}"}], ",", 
       RowBox[{
        RowBox[{"lamN", "=", 
         RowBox[{"N", "[", "lam", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"kN", "=", 
         RowBox[{"N", "[", "k", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"MN", "=", 
         RowBox[{"N", "[", "M", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rh", "=", 
         RowBox[{"rhBH", "[", 
          RowBox[{"lamN", ",", "kN", ",", "MN"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rmin", "=", 
         RowBox[{"rh", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"10", "^", 
             RowBox[{"-", "8"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rmax", "=", 
         RowBox[{"100", " ", "MN"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ngrid", "=", "800"}], ";", "\[IndentingNewLine]", 
        RowBox[{"grid", "=", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"rmin", ",", "rmax", ",", "ngrid"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vals", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"VBH", "[", 
            RowBox[{"#", ",", "l", ",", "lamN", ",", "kN", ",", "MN"}], "]"}],
            "&"}], "/@", "grid"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"imax", "=", 
         RowBox[{"First", "[", 
          RowBox[{"Ordering", "[", 
           RowBox[{"vals", ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"imax", "==", "1"}], "||", 
           RowBox[{"imax", "==", 
            RowBox[{"Length", "[", "grid", "]"}]}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<Warning: maximum at boundary\>\"", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", 
            RowBox[{"grid", "[", 
             RowBox[{"[", "imax", "]"}], "]"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rleft", "=", 
         RowBox[{"grid", "[", 
          RowBox[{"[", 
           RowBox[{"imax", "-", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rmid", "=", 
         RowBox[{"grid", "[", 
          RowBox[{"[", "imax", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rright", "=", 
         RowBox[{"grid", "[", 
          RowBox[{"[", 
           RowBox[{"imax", "+", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dVexpr", "=", 
