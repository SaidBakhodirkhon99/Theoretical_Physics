         RowBox[{
          RowBox[{"fpBH", "[", 
           RowBox[{"r", ",", "lam", ",", "k", ",", "M"}], "]"}], "/", "r"}]}],
         ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
