        RowBox[{"rh", "=", 
         RowBox[{"rhBH", "[", 
          RowBox[{"lamN", ",", "kN", ",", "MN"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rmin", "=", 
