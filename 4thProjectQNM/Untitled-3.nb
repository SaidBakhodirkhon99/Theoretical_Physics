    RowBox[{"kValues", "=", 
     RowBox[{"{", 
      RowBox[{"0.1", ",", "0.2", ",", "0.3", ",", "0.4"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Metric", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fBH", "[", 
      RowBox[{"r_", ",", "lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "k"}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "M"}], ")"}], "/", "r"}], "+", 
      RowBox[{
       RowBox[{"lam", "/", "r"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"r", "/", "lam"}], "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fpBH", "[", 
      RowBox[{"r_", ",", "lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"M", "/", 
        RowBox[{"r", "^", "2"}]}]}], "+", 
      RowBox[{"lam", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Log", "[", 
           RowBox[{"r", "/", "lam"}], "]"}]}], ")"}], "/", 
        RowBox[{"r", "^", "2"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Scalar", " ", "perturbation", " ", "potential"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VBH", "[", 
      RowBox[{"r_", ",", "l_", ",", "lam_", ",", "k_", ",", "M_"}], "]"}], ":=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"fBH", "[", 
