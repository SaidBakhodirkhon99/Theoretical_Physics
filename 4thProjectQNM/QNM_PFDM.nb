       RowBox[{"PlotStyle", "->", 
        RowBox[{"Lighter", "[", "LightBlue", "]"}]}], ",", 
       RowBox[{"BoundaryStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Thick"}], "]"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"Axes", "->", "False"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
