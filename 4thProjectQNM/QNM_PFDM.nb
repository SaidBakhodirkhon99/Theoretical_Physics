Cell[BoxData[{
 RowBox[{
  RowBox[{"bhregion", "=", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"RegionPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"0", "<=", "k", "<", "1"}], "&&", 
        RowBox[{"0", "<", "\[Lambda]", "<=", "1"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
