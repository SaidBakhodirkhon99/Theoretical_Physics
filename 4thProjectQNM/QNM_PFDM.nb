             RowBox[{"\"\<\\lambda\>\"", ",", 
              RowBox[{"Magnification", "->", "1.3"}]}], "]"}], ",", "18"}], 
           "]"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"White", ",", 
        RowBox[{"EdgeForm", "[", "Black", "]"}], ",", 
        RowBox[{"Disk", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], ",", "0.015"}], "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"open", " ", "circle", " ", "at", " ", "k"}], "=", "1"}], 
         "*)"}], 
        RowBox[{"Disk", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", "0.015"}], "]"}], ",", 
        RowBox[{"(*", 
