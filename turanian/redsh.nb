Cell[BoxData[
 RowBox[{
  RowBox[{"ve", "[", 
   RowBox[{"r_", ",", "\[Zeta]_"}], "]"}], "=", 
  SqrtBox[
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"r", ",", "\[Zeta]"}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{"6", "/", 
