Cell[BoxData[
 RowBox[{
  SqrtBox["6"], " ", 
  SqrtBox[
   FractionBox[
    RowBox[{"1", "-", 
     FractionBox["2", "r"], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox["2", "r"]}], ")"}], "2"], " ", 
       SuperscriptBox["\[Zeta]", "2"]}], 
      SuperscriptBox["r", "2"]]}], 
