Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Veff", "[", 
    RowBox[{"r_", ",", "\[Zeta]_", ",", "Ene_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["Ene", "2"], " ", 
        SuperscriptBox["r", "2"]}], " ", "+", " ", 
       RowBox[{
        SuperscriptBox["L", "2"], " ", 
        RowBox[{"g00", "[", 
         RowBox[{"r", ",", "\[Zeta]"}], "]"}]}]}], ")"}], 
     RowBox[{
      RowBox[{"g00", "[", 
       RowBox[{"r", ",", "\[Zeta]"}], "]"}], " ", 
      SuperscriptBox["r", "2"]}]], "+", "1"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9604242907002993`*^9, 3.960424393535409*^9}, {
  3.960969693588941*^9, 3.960969733341569*^9}},
