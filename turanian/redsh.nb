Cell[CellGroupData[{

Cell["redshift parameter z", "Section",
 CellChangeTimes->{{3.960424595576707*^9, 
  3.960424601313532*^9}},ExpressionUUID->"ff3b397d-449e-41a1-8f47-\
9434411c5daa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g00", "[", 
    RowBox[{"r_", ",", "\[Zeta]_"}], "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"1", "-", " ", 
      FractionBox["2", "r"], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox["\[Zeta]", "2"], 
        SuperscriptBox["r", "2"]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox["2", "r"]}], ")"}], "2"]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", 
    RowBox[{"r_", ",", "\[Zeta]_"}], "]"}], "=", " ", 
   SqrtBox[
    FractionBox[
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["r", "2"]}], "*", " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"g00", "[", 
         RowBox[{"r", ",", "\[Zeta]"}], "]"}], ",", "r"}], "]"}]}], 
     RowBox[{
      RowBox[{"g00", "[", 
       RowBox[{"r", ",", "\[Zeta]"}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", "r", " ", "*", 
         RowBox[{"g00", "[", 
          RowBox[{"r", ",", "\[Zeta]"}], "]"}]}], "-", 
        RowBox[{
         SuperscriptBox["r", "2"], "*", " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"g00", "[", 
            RowBox[{"r", ",", "\[Zeta]"}], "]"}], ",", "r"}], "]"}]}]}], 
       ")"}]}]]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.960422864013257*^9, 3.960422879988166*^9}, {
  3.960422920572315*^9, 3.9604229390801783`*^9}, {3.960424285019208*^9, 
