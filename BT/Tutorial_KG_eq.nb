Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"R", "''"}], "[", "r", "]"}], " ", "-", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"L", " ", 
          RowBox[{"(", 
           RowBox[{"L", "+", "1"}], ")"}]}], 
         SuperscriptBox["r", "2"]], "-", 
        SuperscriptBox["\[Omega]", "2"], "-", 
        SuperscriptBox["m", "2"]}], ")"}], 
      RowBox[{"R", "[", "r", "]"}]}]}], "\[Equal]", "0"}], ",", 
   RowBox[{"R", "[", "r", "]"}], ",", "r"}], "]"}]], "Input",
 CellChangeTimes->{{3.9667761447817163`*^9, 3.966776215146467*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"9debe147-99a8-4d1e-a73b-7a6622d3c686"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"R", "[", "r", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      SqrtBox["r"], " ", 
      RowBox[{"BesselJ", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "L"}]}], ")"}]}], ",", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "r", " ", 
         SqrtBox[
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["m", "2"]}], "-", 
           SuperscriptBox["\[Omega]", "2"]}]]}]}], "]"}], " ", 
      TemplateBox[{"1"},
       "C"]}], "+", 
     RowBox[{
      SqrtBox["r"], " ", 
      RowBox[{"BesselY", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "L"}]}], ")"}]}], ",", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "r", " ", 
         SqrtBox[
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox["m", "2"]}], "-", 
           SuperscriptBox["\[Omega]", "2"]}]]}]}], "]"}], " ", 
      TemplateBox[{"2"},
       "C"]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.966776216366041*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"0a779418-2ce7-4aab-bfd1-3fc32c1c1fff"]
}, Open  ]],

